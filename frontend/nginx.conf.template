server_tokens off;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # No URI part in proxy_pass: the request line passes unmodified.
    location ^~ /api/v1/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 2s;
        # An unreachable API is a bad gateway for the client (its http_error).
        error_page 504 = @bad_gateway;
        proxy_read_timeout 30s;
    }

    # nginx resolves ".." before matching, so /api/v1/../x becomes /api/x.
    # Anything under /api/ other than /api/v1/ is an error, not the SPA.
    location ^~ /api/ {
        return 404;
    }

    location @bad_gateway {
        return 502;
    }

    # Internal endpoints are never reachable from outside.
    location ^~ /internal/ {
        return 404;
    }

    location = /healthz { return 404; }
    location = /readyz { return 404; }

    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
