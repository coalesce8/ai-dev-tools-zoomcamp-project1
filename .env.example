# Runwatch settings. Copy to .env and adjust; every setting the app reads is
# listed here. Never commit real secrets.

# SQLAlchemy URL of the PostgreSQL database (required). Uses the psycopg 3
# driver. The default points at the shared runwatch-pg container.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/runwatch

# Seconds to wait when connecting to the database before giving up (default 2).
# Also bounds how long /readyz takes to report an unreachable database.
DB_CONNECT_TIMEOUT_S=2

# Read only by the Vite dev server (`npm run dev` in frontend/), which proxies
# /api/v1 to it. Not read by the API or by the built app.
API_PROXY_TARGET=http://localhost:8000

# Run the lease sweeper thread inside the API (default true). It moves RUNNING
# jobs whose lease expired to STALLED every 5 s. Set false to switch it off.
SWEEPER_ENABLED=true

# Base URL of the API, used by the worker and the load generator (required for
# both; they never read DATABASE_URL).
RUNWATCH_API_URL=http://localhost:8000

# Worker id sent on claim (1-255 characters). Default: <hostname>-<pid>.
# WORKER_ID=

# Worker fault injection. "fail_all" makes every attempt fail with cause infra;
# anything else or unset means no fault. Read once at worker startup.
# WORKER_FAULT=

# Seconds between load generator submissions (number greater than 0).
LOADGEN_INTERVAL_S=10

# Docker Compose (`docker compose up --build`). Compose does not read
# DATABASE_URL above (it points at localhost and would break the containers; it
# sets its own for the containers), and a .env is optional for Compose.

# Password of the Compose Postgres container. Demo only: the database is not
# published on the host.
POSTGRES_PASSWORD=postgres

# Host port the UI is published on (http://localhost:8080).
FRONTEND_PORT=8080

# Host address the UI port binds to. Set 0.0.0.0 to expose it beyond localhost.
FRONTEND_BIND=127.0.0.1

# Base URL of an OTLP/HTTP collector such as http://localhost:4318. Unset means
# spans are created but not exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Log level of every Runwatch process: DEBUG, INFO, WARNING or ERROR (case
# insensitive, default INFO). Logs are JSON lines on stdout and, with
# OTEL_EXPORTER_OTLP_ENDPOINT set, OTLP records too.
# LOG_LEVEL=INFO

# Observability stack in Compose (collector, Prometheus, Tempo, Loki, Grafana).
# Host port of Grafana (http://localhost:3001). Not 3000: another stack on the
# VM uses it.
GRAFANA_PORT=3001

# Host port of Prometheus (http://localhost:9091). Not 9090: another stack on
# the VM uses it.
PROMETHEUS_PORT=9091

# Host address the Grafana and Prometheus ports bind to. Grafana has no login,
# so keep 127.0.0.1 unless the machine is trusted.
OBSERVABILITY_BIND=127.0.0.1

# Value of the `env` label / deployment.environment attribute on all
# telemetry, used by the alert routing. Leave it local under Compose.
DEPLOYMENT_ENVIRONMENT=local
